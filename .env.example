# ── Mail-Automation configuration ────────────────────────────────────────────
# Copy to .env and adjust. Every value below is optional; sane defaults are
# used so `npm run serve` works with zero configuration (messages are captured
# in the built-in Inbox instead of being delivered over SMTP).

# HTTP
PORT=8787
HOST=0.0.0.0
# Who may embed the app in an <iframe>: 'self' (default), a space separated origin list, or * to
# allow any embedder (useful for a hosted preview). Session cookies stay SameSite=Lax.
FRAME_ANCESTORS='self'
NODE_ENV=development

# Absolute base URL used to build open/click/unsubscribe links.
# Leave empty to derive it from the incoming request (handy behind a proxy).
PUBLIC_BASE_URL=

# Session signing secret. Generate one with:  openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=720

# Storage
DB_PATH=var/mail-automation.db
MAIL_DIR=var/mail

# ── Delivery ─────────────────────────────────────────────────────────────────
# transport = auto | smtp | memory
#   auto   -> smtp when SMTP_HOST is set, otherwise memory (captured in /inbox)
#   memory -> never talks to the network; renders + stores every message
MAIL_TRANSPORT=auto

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_POOL=4
SMTP_MAX_MESSAGES=50

# Default sender identity (can be overridden per campaign, in the UI).
FROM_EMAIL=noreply@example.com
FROM_NAME=Mail Automation
REPLY_TO=

# Sending engine
SEND_TICK_MS=1000
SEND_RATE_PER_MINUTE=30
SEND_DAILY_CAP=2000
SEND_MAX_ATTEMPTS=4
SEND_BACKOFF_BASE_SECONDS=30

# Bootstrap admin account, created on first start when the users table is empty.
ADMIN_EMAIL=admin@maillocal.dev
ADMIN_PASSWORD=change-me-please

# Set to "1" to load demo lists/contacts/templates/campaigns on an empty DB.
SEED_DEMO=1
