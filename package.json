{
  "name": "mail-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted email automation platform: lists, segments, templates, drip sequences, tracked sending and live analytics.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "serve": "npm run build && npm start",
    "seed": "tsx src/server/db/seed.ts",
    "reset": "node --input-type=module -e \"import('node:fs').then(fs=>fs.rmSync('var',{recursive:true,force:true})).then(()=>console.log('workspace data cleared'))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node --check src/server/index.ts && echo ok"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^7.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.8",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "happy-dom": "^20.12.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
